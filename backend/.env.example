# Backend Environment Variables
# Copy this file to .env and fill in your values

# Optional: OpenRouter API key for AI chatbot
# Get a free key at https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_key_here

# Frontend URL for CORS (set this on Render to your deployed Vercel URL)
# Example: https://greenscan.vercel.app
FRONTEND_URL=http://localhost:5173

# Farmer Safety & Validation Thresholds (optional – defaults are shown)
# MIN_CONFIDENCE_THRESHOLD=0.65
# BLUR_THRESHOLD=80.0
# BRIGHTNESS_MIN=30.0
# BRIGHTNESS_MAX=230.0
# GRADCAM_THRESHOLD=0.60
